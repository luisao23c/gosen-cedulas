# Copia este archivo a `.env.local` (desarrollo) o cárgalo como variables de entorno en Vercel.
# NUNCA subas `.env.local` a Git: ya está ignorado.

# ── Base de datos MySQL ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=gosen
DB_CONTRASENA=cambia-esto
DB_NOMBRE=gosen

# Base gestionada (Aiven, TiDB…): TLS y pocas conexiones por instancia
# DB_SSL=true
# DB_CONEXIONES=3

# Solo para `npm run db:setup` / `db:migrar-todo` contra una base remota (no hay usuario root)
# DB_REMOTA=true

# Instalación limpia (producción): `db:setup` crea SOLO este administrador, sin datos de prueba.
# (Sin ADMIN_CONTRASENA siembra cuentas de prueba con contraseña conocida: solo para desarrollo.)
# ADMIN_EMAIL=tu@correo.com
# ADMIN_CONTRASENA=10 caracteres o más, con letras y números

# ── Sesión ──────────────────────────────────────────────────────────
# OBLIGATORIA en producción: cadena aleatoria de 32+ caracteres. Sin ella, nadie puede iniciar sesión
# (en desarrollo se usa un secreto de ejemplo). Ver DESPLIEGUE.md.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRETO_SESION=
