# Copia este archivo a `.env.local` (desarrollo) o cárgalo como variables de entorno en Vercel.
# NUNCA subas `.env.local` a Git: ya está ignorado.

# ── Base de datos MySQL ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=gosen
DB_CONTRASENA=cambia-esto
DB_NOMBRE=gosen

# Base gestionada (Aiven, TiDB…): TLS y pocas conexiones por instancia
# DB_SSL=true
# DB_CONEXIONES=3

# Solo para `npm run db:setup` contra una base remota (no hay usuario root)
# DB_REMOTA=true

# ── Sesión ──────────────────────────────────────────────────────────
# Cadena larga y aleatoria (32+ caracteres). Sin ella, las sesiones no son seguras.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRETO_SESION=
